{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Arm E (prompts/E-json-ui.md). The validator in src/kit/json-ui.ts is the authority; it also checks table row widths and diagram edge ends, which this schema cannot.",
  "type": "object",
  "required": ["page"],
  "properties": {
    "page": {
      "type": "object",
      "required": ["title", "sections"],
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["heading", "blocks"],
      "properties": {
        "heading": { "type": "string" },
        "level": { "enum": [1, 2, 3] },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["text", "list", "kpi", "table", "chart", "callout", "steps", "cards", "diagram", "code"] } },
      "oneOf": [
        { "properties": { "type": { "const": "text" }, "text": { "type": "string" } }, "required": ["text"] },
        { "properties": { "type": { "const": "list" }, "items": { "type": "array", "items": { "type": "string" } }, "ordered": { "type": "boolean" } }, "required": ["items"] },
        { "properties": { "type": { "const": "kpi" }, "tiles": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "string" }, "note": { "type": "string" }, "trend": { "enum": ["up", "down", "flat"] } } } } }, "required": ["tiles"] },
        { "properties": { "type": { "const": "table" }, "columns": { "type": "array", "items": { "type": "string" } }, "rows": { "type": "array", "items": { "type": "array", "items": { "type": ["string", "number"] } } }, "align": { "type": "array", "items": { "enum": ["left", "right"] } } }, "required": ["columns", "rows"] },
        { "properties": { "type": { "const": "chart" }, "kind": { "enum": ["line", "bar", "pie"] }, "title": { "type": "string" }, "unit": { "type": "string" }, "series": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "points"], "properties": { "name": { "type": "string" }, "points": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "string" }, "y": { "type": "number" } } } } } } } }, "required": ["kind", "series"] },
        { "properties": { "type": { "const": "callout" }, "tone": { "enum": ["note", "warning", "critical"] }, "text": { "type": "string" } }, "required": ["tone", "text"] },
        { "properties": { "type": { "const": "steps" }, "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" }, "detail": { "type": "string" }, "when": { "type": "string" } } } } }, "required": ["items"] },
        { "properties": { "type": { "const": "cards" }, "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["title", "text"], "properties": { "title": { "type": "string" }, "text": { "type": "string" }, "tag": { "type": "string" } } } } }, "required": ["items"] },
        { "properties": { "type": { "const": "diagram" }, "kind": { "enum": ["flow", "sequence"] }, "nodes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "group": { "type": "string" } } } }, "edges": { "type": "array", "items": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "label": { "type": "string" } } } } }, "required": ["kind", "nodes"] },
        { "properties": { "type": { "const": "code" }, "language": { "type": "string" }, "text": { "type": "string" } }, "required": ["text"] }
      ]
    }
  }
}
