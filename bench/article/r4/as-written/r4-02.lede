data range += HB-004,Salt & Vinegar Gose,4.1,4 x 473 mL,"2,240","17,920","love it or hate it; stockists want a warning on the label?"; HB-005,Dock Street Lager,4.6,12 x 355 mL,"24,880","174,160","volume driver, bars and grocery"; HB-006,"“Last Call” Barleywine",10.4,500 mL,910,"13,650","gift buyers; vintage-dated each year"
