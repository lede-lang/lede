data lat = week,p50,p95,p99,SLO; W30,42,180,410,600; W31,41,176,402,600; W32,44,191,437,600; W33,43,188,428,600; W34,47,214,506,600; W35,52,263,688,600; W36,49,231,574,600; W37,45,198,455,600; W38,44,187,431,600; W39,40,172,398,600; W40,39,168,384,600; W41,38,161,369,600
