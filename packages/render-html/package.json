{
  "name": "@lede-lang/html",
  "version": "0.2.10",
  "description": "Lede (lede-lang): the line format an AI model writes instead of HTML. One self-contained page out, no script, no automatic remote fetch. This package renders a document to the page.",
  "keywords": [
    "lede",
    "html",
    "renderer",
    "charts",
    "diagrams"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lede-lang/lede.git",
    "directory": "packages/render-html"
  },
  "homepage": "https://ledelang.dev",
  "author": {
    "name": "Andrew Chemis",
    "url": "https://andrewchemis.dev"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/shell-runtime.js",
    "!src/shell-runtime.sha256"
  ],
  "exports": "./src/index.ts",
  "dependencies": {
    "@lede-lang/core": "workspace:*",
    "elkjs": "^0.11.0",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.13.0",
    "htmlparser2": "^12.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  }
}
