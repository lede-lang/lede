{
  "name": "@lede-lang/html",
  "version": "0.1.4",
  "description": "Renders a Lede document to one self-contained, zero-JavaScript HTML page",
  "keywords": [
    "lede",
    "html",
    "renderer",
    "charts",
    "diagrams"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lede-lang/lede.git",
    "directory": "packages/render-html"
  },
  "homepage": "https://github.com/lede-lang/lede#readme",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src"
  ],
  "exports": "./src/index.ts",
  "dependencies": {
    "@lede-lang/core": "workspace:*",
    "elkjs": "^0.11.0",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.13.0",
    "htmlparser2": "^12.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  }
}
