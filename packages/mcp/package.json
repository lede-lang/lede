{
  "name": "@lede-lang/mcp",
  "version": "0.2.4",
  "private": true,
  "description": "An MCP server that lets a model check and compile Lede pages, and read the model reference",
  "keywords": [
    "lede",
    "mcp",
    "model-context-protocol",
    "html",
    "document-format"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lede-lang/lede.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://ledelang.dev",
  "author": {
    "name": "Andrew Chemis",
    "url": "https://andrewchemis.dev"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "spec"
  ],
  "bin": {
    "lede-mcp": "./src/server.ts"
  },
  "scripts": {
    "prepack": "node scripts/copy-spec.ts"
  },
  "dependencies": {
    "@lede-lang/core": "workspace:*",
    "@lede-lang/html": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "bin": {
      "lede-mcp": "./dist/server.js"
    }
  }
}
