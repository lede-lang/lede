{
  "name": "@lede-lang/cli",
  "version": "0.2.5",
  "description": "Lede (lede-lang): the line format an AI model writes instead of HTML. One self-contained page out, no script, no automatic remote fetch. This package is the `lede` command.",
  "keywords": [
    "lede",
    "cli",
    "html",
    "document-format"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lede-lang/lede.git",
    "directory": "packages/cli"
  },
  "homepage": "https://ledelang.dev",
  "author": {
    "name": "Andrew Chemis",
    "url": "https://andrewchemis.dev"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src"
  ],
  "bin": {
    "lede": "./src/cli.ts"
  },
  "exports": {
    "./confine": "./src/confine.ts"
  },
  "dependencies": {
    "@lede-lang/core": "workspace:*",
    "@lede-lang/html": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "bin": {
      "lede": "./dist/cli.js"
    },
    "exports": {
      "./confine": {
        "types": "./dist/confine.d.ts",
        "default": "./dist/confine.js"
      }
    }
  }
}
