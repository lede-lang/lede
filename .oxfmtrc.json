{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "printWidth": 140,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "packages/*/dist/**",
    "pnpm-lock.yaml",
    "bench/gen/**",
    "bench/out/**",
    "bench/results/**",
    "bench/briefs/**",
    "bench/tasks/**",
    "bench/prompts/**",
    "bench/article/**",
    "conformance/**/*.json",
    "examples/**",
    ".claude/**",
    "**/*.md",
    "**/*.lede",
    "**/*.json",
    "**/*.jsonc",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html",
    "**/*.css",
    "**/*.csv",
    "**/*.txt"
  ]
}
