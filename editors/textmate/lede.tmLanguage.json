  "repository": {
    "string": {
      "name": "string.quoted.double.lede",
      "match": "\"(?:\"\"|\\\\\"|[^\"])*\""
    },
    "date": {
      "name": "constant.numeric.date.lede",
      "match": "(?<![\\w.])\\d{4}-\\d{2}-\\d{2}(?![\\w.])"
    },
    "number": {
      "name": "constant.numeric.lede",
      "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?(?![\\w.])"
    },
    "reference": {
      "match": "(?<=\\s)(=)([A-Za-z_][\\w-]*)(\\.)(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.operator.reference.lede"
        },
        "2": {
          "name": "variable.other.lede"
        },
        "3": {
          "name": "punctuation.accessor.lede"
        },
        "4": {
          "name": "variable.other.property.lede"
        }
      }
    },
    "option": {
      "match": "(?<![\\w-])([A-Za-z][\\w-]*)(\\+?=)",
      "captures": {
        "1": {
          "name": "variable.parameter.option.lede"
        },
        "2": {
          "name": "keyword.operator.assignment.lede"
        }
      }
    },
    "pipe": {
      "name": "punctuation.separator.pipe.lede",
      "match": "\\|"
    },
    "row-sep": {
      "name": "punctuation.separator.row.lede",
      "match": ";"
    },
    "field-sep": {
      "name": "punctuation.separator.field.lede",
      "match": ","
    },
    "arrow": {
      "name": "keyword.operator.arrow.lede",
      "match": "<->|-->|-x->|(?<=\\s)-x-(?=\\s)|->"
    },
    "inline": {
      "patterns": [
        {
          "name": "constant.character.escape.lede",
          "match": "\\\\[`*_\\[\\]\\\\]"
        },
        {
          "name": "markup.inline.raw.lede",
          "match": "(`+)(?!`).+?(?<!`)\\1(?!`)"
        },
        {
          "name": "markup.bold.lede",
          "match": "\\*\\*(?=\\S).+?(?<=\\S)\\*\\*"
        },
        {
          "name": "markup.italic.lede",
          "match": "(?<![\\w*])([*_])(?=[^\\s*_]).*?(?<=[^\\s*_])\\1(?![\\w*])"
        },
        {
          "name": "meta.link.inline.lede",
          "match": "(\\[)([^\\[\\]]+)(\\])(\\()([^\\s()]*(?:\\([^\\s()]*\\)[^\\s()]*)*)(\\))",
          "captures": {
            "1": {
              "name": "punctuation.definition.link.begin.lede"
            },
            "2": {
              "name": "string.other.link.title.lede"
            },
            "3": {
              "name": "punctuation.definition.link.end.lede"
            },
            "4": {
              "name": "punctuation.definition.metadata.begin.lede"
            },
            "5": {
              "name": "markup.underline.link.lede"
            },
            "6": {
              "name": "punctuation.definition.metadata.end.lede"
            }
          }
        }
      ]
    },
    "meta.table-row": {
      "name": "meta.table-row.lede",
      "match": "^\\s*(:)(?=\\s|$)(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.table-row.lede"
        },
        "2": {
          "patterns": [
            {
              "include": "#pipe"
            },
            {
              "include": "#inline"
            }
          ]
        }
      }
    },
    "markup.fenced_code.block.raw-html": {
      "name": "markup.fenced_code.block.raw-html.lede",
      "begin": "^\\s*(`{3,})\\s*(=)(html)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.markdown.lede"
        },
        "2": {
          "name": "keyword.operator.raw.lede"
        },
        "3": {
          "name": "fenced_code.block.language.lede"
        }
      },
      "end": "^\\s*\\1`*\\s*$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.markdown.lede"
        }
      },
      "contentName": "meta.embedded.block.html",
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "invalid.illegal.raw-format": {
      "name": "invalid.illegal.raw-format.lede",
      "match": "^\\s*`{3,}\\s*=(?!html\\s*$)[\\w+-]*\\s*$"
    },
    "markup.fenced_code.block.js": {
