data flags = area,flag,today,proposed,rollout today,rollout proposed,requires,owner; checkout,checkout_v2,On,On,100,100,payments_tokenization,Dana
data flags += checkout,checkout_express_pay,Off,On,0,10,"checkout_v2 + payments_tokenization",Dana
data flags += checkout,checkout_saved_cards,On,On,60,100,payments_tokenization,Dana
data flags += payments,payments_tokenization,On,On,100,100,none,Ravi
data flags += payments,payments_3ds2,On,On,100,100,payments_tokenization,Ravi
data flags += search,search_typeahead,On,On,100,100,none,Mei
data flags += search,search_embeddings,Off,On,0,100,platform_event_bus,Mei
data flags += search,search_semantic,Off,On,0,25,search_embeddings,Mei
data flags += billing,billing_invoices_v2,On,On,100,100,none,Omar
data flags += billing,billing_tax_eu,On,On,100,100,billing_invoices_v2,Omar
